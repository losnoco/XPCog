// The application's Last.fm API credentials, baked in at configure time.
//
// Cog does exactly this and ships blank: `Xcode-config/Secrets.template.xcconfig`
// carries empty `LASTFM_API_KEY` and `LASTFM_API_SECRET`, a script generates a
// Swift file from it, and `AudioScrobbler.enabled` returns false whenever either
// is empty. So a build from a clean checkout has scrobbling compiled in and
// switched off, and the person building it applies for their own key.
//
// The same arrangement here, for the same two reasons. An API key in a public
// repository is a key that gets used by things that are not this program and
// revoked accordingly; and the key identifies the *application* to Last.fm, so
// somebody's fork submitting under XPCog's identity is a misattribution rather
// than a favour.
//
// To build with scrobbling live, apply at https://www.last.fm/api/account/create
// and configure with:
//
//   cmake --preset windows-debug \
//       -D XPCOG_LASTFM_API_KEY=... -D XPCOG_LASTFM_API_SECRET=...
//
// Without them everything below still compiles and the preferences pane says the
// feature is not available in this build -- the same shape as the crash-reporting
// checkbox in a build without Sentry, and for the same reason: a control that
// ticks and does nothing is worse than one that explains itself.

#pragma once

#include <string_view>

namespace xpcog::app::secrets {

inline constexpr std::string_view kLastFmApiKey    = "@XPCOG_LASTFM_API_KEY@";
inline constexpr std::string_view kLastFmApiSecret = "@XPCOG_LASTFM_API_SECRET@";

}  // namespace xpcog::app::secrets
