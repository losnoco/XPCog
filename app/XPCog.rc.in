// Windows version resource. Configured by app/CMakeLists.txt so the version
// comes from PROJECT_VERSION rather than being maintained twice.
//
// This is the Windows equivalent of the Info.plist that MACOSX_BUNDLE_* fills
// in. It was hand-written under Qt because Qt did not supply one -- the
// QT_TARGET_* properties look like they would, but the generator behind them is
// only ever called from Qt's own internal build helpers -- and it stays
// hand-written now for the simpler reason that nothing else writes one.
//
// FileDescription is what Task Manager shows in place of the raw image name, and
// what the Details tab of the file's properties reads.
//
// It is *not* enough to name the app in the System Media Transport Controls
// card, which stays captioned "Unknown app" -- verified, rather than assumed, and
// since verified a second time against the FriendlyAppName that `--register`
// writes. File metadata of any kind is ruled out by experiment.
//
// The reason is that the SMTC identifies a session by AppUserModelID
// (GlobalSystemMediaTransportControlsSession.SourceAppUserModelId), and only a
// *packaged* application has one that resolves to a name -- full MSIX or an
// external-location "sparse" package, both of which belong to installation and
// need a signing certificate. docs/PORTING.md records the whole finding rather
// than this file pretending a version resource could do it.
//
#include <winver.h>

// ---------------------------------------------------------------------------
// wx's own resources, and they are not optional.
//
// Two things live in wx.rc that the application is visibly wrong without, and
// both were previously supplied by Qt's platform plugin rather than by this file:
//
//   * The **DPI-awareness manifest**. Without it Windows marks the process
//     DPI-unaware and bitmap-scales the entire window to the monitor's scale
//     factor -- so every control, every icon and every glyph is drawn at 96 dpi
//     and then stretched. The symptom is exactly what it sounds like: the window
//     looks soft and pixelated on a HiDPI display while every other application
//     looks sharp. wxUSE_DPI_AWARE_MANIFEST=2 asks for Per-Monitor V2, which is
//     what makes FromDIP() mean anything and what lets the window re-scale when
//     it is dragged between monitors.
//
//   * The **common-controls v6 manifest**. Without it the native controls fall
//     back to their Windows 95 appearance, which is the other half of "this does
//     not look like a native application".
//
// Both symbols are needed, and the first is easy to miss: wx.rc emits *no*
// manifest at all unless wxUSE_RC_MANIFEST is defined and non-zero, so setting
// only the DPI one produces a binary with neither. Verified by looking for
// "dpiAwareness" in the linked executable rather than by reading the header --
// the first attempt here set only the second symbol and shipped an unaware
// process that looked exactly like the bug it was meant to fix.
//
// Ahead of the icon deliberately: the include has to precede anything that
// depends on the manifest being present. It also brings nine icons of its own,
// which is what the name below is about.
#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2
#include "wx/msw/wx.rc"

// The application icon, and the name is load-bearing.
//
// Explorer, the taskbar, Alt-Tab and the `,0` icon index that `--register`
// writes into DefaultIcon all take the *first* icon group in the executable's
// resource directory. A PE resource directory orders **named entries before
// numbered ones**, names sorted alphabetically -- so "first" is not "lowest id",
// and an icon numbered 1 loses to any icon with a name at all.
//
// wx.rc above defines nine, starting with wxICON_AAA, and its own comment says
// what that name is for: "First wx icon in alphabetical order. Notice that it
// also may be used by Explorer as the application icon if the main program
// doesn't define any icons preceding this one in alphabetical order."
//
// This was `1 ICON` until it was looked at, on the reasoning that wx names its
// resources and therefore could not take id 1 -- true, and beside the point,
// because it never needed id 1 to win. The result was a player whose executable
// and whose registered audio files both showed the wxWidgets default icon, on
// every build since the toolkit changed. Nothing warns; the artwork is present
// in the binary and simply never chosen.
//
// So: a name that sorts ahead of wxICON_AAA. Leading A's rather than something
// descriptive because alphabetical order is the entire mechanism, and a name
// that reads well but sorts late is the bug coming back.
//
// This is the free-form artwork, not the rounded tile the macOS bundle uses.
// Windows draws an app icon on its own background -- the taskbar, a dark title
// bar, a Start tile -- so a light tile of our own would read as a pale box
// pasted onto whatever is behind it.
AAAA_XPCOG ICON "@XPCOG_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @XPCOG_RC_VERSION@
    PRODUCTVERSION @XPCOG_RC_VERSION@
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0x0L
#endif
    FILEOS      VOS_NT_WINDOWS32
    FILETYPE    VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = en-US, 04B0 = Unicode.
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "XPCog"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "XPCog"
            VALUE "OriginalFilename", "XPCog.exe"
            VALUE "ProductName",      "XPCog"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
