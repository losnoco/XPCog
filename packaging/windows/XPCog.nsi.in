; XPCog's Windows installer.
;
; Configured by packaging/windows/CMakeLists.txt -- the @VARIABLES@ below are
; filled in by CMake, and the file list this ships comes from Harvest.cmake,
; which reads the staged build output. Nothing here enumerates DLLs by hand.
;
; Build it with:
;
;     cmake --build build/windows-release --target installer
;
; --- What this exists to do beyond copying files ---------------------------
;
; What the build tree cannot do for itself:
;
;   * A Start menu shortcut. docs/PORTING.md records why this waits on an
;     installer rather than the app writing to the Start menu at first run.
;   * File associations: XPCog added to each extension's "Open with" list, for
;     the extensions this build's codecs claim -- Associations.cmake asks the
;     codec registry at packaging time and generates the lines. Written here,
;     under the install's own scope, and removed by the uninstaller.
;   * For the WinUI player, the Windows App Runtime it runs on, fetched from
;     Microsoft when the machine does not have it already.
;   * An uninstaller, and an Add/Remove Programs entry, so a folder of 45 DLLs
;     can be removed by the means Windows users actually reach for.
;
; --- Command line ----------------------------------------------------------
;
;   /S                  silent; no windows, no questions
;   /AllUsers           install for everyone (Program Files; needs elevation)
;   /CurrentUser        install for the running user only (no elevation)
;   /NOASSOC            do not touch file associations
;   /NORUNTIME          do not fetch the Windows App Runtime (WinUI player)
;   /D=<dir>            installation directory; must be last, and unquoted
;
; The uninstaller takes /S and the same two scope switches; the scope it was
; installed with is baked into the UninstallString, so Add/Remove Programs
; passes the right one without anyone having to remember.

; `Target amd64-unicode` with an NSIS that has the stubs for it, and `Unicode
; true` -- a 32-bit installer -- with one that does not. Which of the two this
; is was decided at configure time by compiling a two-line script and seeing
; whether it built; packaging/windows/CMakeLists.txt says what the choice is
; worth. Both installers install the same 64-bit XPCog.
@XPCOG_NSIS_TARGET@
ManifestDPIAware true
SetCompressor /SOLID lzma
CRCCheck on

!define XPCOG_NAME      "XPCog"
!define XPCOG_VERSION   "@XPCOG_VERSION@"
!define XPCOG_PUBLISHER "LoSnoCo"
!define XPCOG_URL       "https://github.com/losnoco/XPCog"

; The player this installer carries -- XPCOG_INSTALLER_PLAYER in
; packaging/windows/CMakeLists.txt -- and so the executable everything below
; points at. XPCOG_WINUI is 1 for the WinUI player, which needs the Windows App
; Runtime installed beside it.
!define XPCOG_EXE       "@XPCOG_PLAYER_EXE@"
!define XPCOG_WINUI     @XPCOG_NSIS_WINUI@

; The file associations' ProgID: what each extension's OpenWithProgids names,
; and what describes the file type and how to open it. The same one the wx
; player's --register writes, so the two never offer XPCog twice.
!define XPCOG_PROGID    "XPCog.AudioFile"
!define XPCOG_CLASSES   "Software\Classes"

; Where Add/Remove Programs looks, and -- because MULTIUSER_INSTALLMODE_*
; below point at it -- also how a second run of this installer discovers where
; the first one put things and which scope it used.
!define XPCOG_UNINST_KEY \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\${XPCOG_NAME}"

Name "${XPCOG_NAME} ${XPCOG_VERSION}"
OutFile "@XPCOG_INSTALLER_OUTPUT_NATIVE@"
BrandingText "${XPCOG_NAME} ${XPCOG_VERSION}"

; So Task Manager, the UAC prompt and the file's own property sheet name this
; program rather than showing a generic "Setup". The UAC dialog reads
; FileDescription, which is the one users are asked to trust something by.
VIProductVersion "@XPCOG_VERSION_4@"
VIAddVersionKey "ProductName"     "${XPCOG_NAME}"
VIAddVersionKey "ProductVersion"  "${XPCOG_VERSION}"
VIAddVersionKey "FileVersion"     "${XPCOG_VERSION}"
VIAddVersionKey "FileDescription" "${XPCOG_NAME} ${XPCOG_VERSION} Setup"
VIAddVersionKey "CompanyName"     "${XPCOG_PUBLISHER}"
VIAddVersionKey "LegalCopyright"  "GNU General Public License, version 3 or later"

; ---------------------------------------------------------------------------
; Interface.
;
; MUI's settings have to be defined before MUI2.nsh is included, and MultiUser.nsh
; includes it for us the moment MULTIUSER_MUI is defined -- so everything the
; interface needs comes first, and the two !includes are the last lines of this
; block rather than the first.
; ---------------------------------------------------------------------------
!define MUI_ICON   "@XPCOG_ICON@"
!define MUI_UNICON "@XPCOG_ICON@"
!define MUI_ABORTWARNING

; MUI's own default, restated because the alternative is silent: without it the
; components page lists sections with no description pane at all.
!define MUI_COMPONENTSPAGE_SMALLDESC

!define MUI_FINISHPAGE_LINK      "XPCog on GitHub"
!define MUI_FINISHPAGE_LINK_LOCATION "${XPCOG_URL}"

; The "run it now" checkbox, routed through Explorer rather than started
; directly. A per-machine install runs elevated, and a process this one starts
; inherits that token: an elevated media player cannot accept a file dragged onto
; it from Explorer (UIPI blocks the drop), and every file it then writes is owned
; by an administrator. Handing the path to the already-running, *un*elevated
; Explorer makes it the parent instead, which drops the token. The usual
; alternative is the StdUtils plugin's ShellExecAsUser; this needs no plugin.
!define MUI_FINISHPAGE_RUN ""
!define MUI_FINISHPAGE_RUN_TEXT "Run ${XPCOG_NAME}"
!define MUI_FINISHPAGE_RUN_FUNCTION XPCogLaunch

; MULTIUSER_EXECUTIONLEVEL Highest asks for elevation only when the user can
; actually have it: an administrator gets the UAC prompt and both scopes, anyone
; else runs unelevated and is given the per-user install without being asked a
; question they cannot answer. MULTIUSER_PAGE_INSTALLMODE hides itself in that
; second case rather than offering a disabled choice.
!define MULTIUSER_EXECUTIONLEVEL Highest
!define MULTIUSER_MUI
!define MULTIUSER_INSTALLMODE_COMMANDLINE
; Program Files, not Program Files (x86). XPCog is x64-only -- see the check in
; .onInit -- and without this an x64 build installs itself into the 32-bit tree.
!define MULTIUSER_USE_PROGRAMFILES64
!define MULTIUSER_INSTALLMODE_INSTDIR "${XPCOG_NAME}"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_KEY "${XPCOG_UNINST_KEY}"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_VALUENAME "InstallLocation"
!define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_KEY "${XPCOG_UNINST_KEY}"
!define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_VALUENAME "InstallLocation"

!include MultiUser.nsh
!include LogicLib.nsh
!include Sections.nsh
!include x64.nsh
!include FileFunc.nsh

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "@XPCOG_LICENSE_FILE@"
!insertmacro MULTIUSER_PAGE_INSTALLMODE
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; After the pages, which is not stylistic: the page macros above unlock the
; strings this loads, and a language inserted first ships an installer whose
; install-mode page is captioned with raw identifiers.
!insertmacro MUI_LANGUAGE "English"

; ---------------------------------------------------------------------------
; Refusing to overwrite a running copy.
;
; A running executable is locked against writing but not against reading, so
; opening it for append is an exact test of the thing that is about to be
; attempted -- and a more honest one than looking for a window or a mutex, which
; answer "is *this user's* XPCog running" rather than "can this file be
; replaced". Without it, NSIS discovers the lock file by file, halfway through,
; and asks about each one.
;
; The label carries ${UNIQUE} because this is inserted into two different
; functions and NSIS labels are function-scoped only within one.
; ---------------------------------------------------------------------------
!macro XPCogAbortIfRunning UNIQUE
    xpcog_running_${UNIQUE}:
    ${If} ${FileExists} "$INSTDIR\${XPCOG_EXE}"
        ClearErrors
        FileOpen $0 "$INSTDIR\${XPCOG_EXE}" a
        ${If} ${Errors}
            ; Silent runs have nobody to ask; failing loudly is the only choice
            ; that does not half-install over a live process.
            ${If} ${Silent}
                SetErrorLevel 2
                Abort
            ${EndIf}
            MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION \
                "${XPCOG_NAME} is running from $INSTDIR.$\n$\nClose it and \
                 choose Retry." \
                IDRETRY xpcog_running_${UNIQUE}
            Abort
        ${Else}
            FileClose $0
        ${EndIf}
    ${EndIf}
!macroend

; ---------------------------------------------------------------------------
; Sections.
; ---------------------------------------------------------------------------
Section "${XPCOG_NAME}" SecCore
    SectionIn RO

    !insertmacro XPCogAbortIfRunning install

    ; An older install in the same place is uninstalled first rather than
    ; written over. Overwriting leaves every file the previous version shipped
    ; and this one does not -- a decoder DLL dropped from vcpkg.json stays on
    ; disk forever, and the uninstaller that could have removed it has by then
    ; been replaced by one that has never heard of it.
    ReadRegStr $R0 SHCTX "${XPCOG_UNINST_KEY}" "UninstallString"
    ${If} $R0 != ""
    ${AndIf} ${FileExists} "$INSTDIR\Uninstall.exe"
        DetailPrint "Removing the previous installation..."
        ; _?= keeps the uninstaller in place instead of copying itself to %TEMP%
        ; and returning immediately, which is what makes ExecWait actually wait.
        ; The price is that it cannot delete itself, so this does.
        ExecWait '"$INSTDIR\Uninstall.exe" /S _?=$INSTDIR'
        Delete "$INSTDIR\Uninstall.exe"
    ${EndIf}

    ; Every File line, generated from what the build staged.
    !include "@XPCOG_GENERATED_DIR_NATIVE@\payload-install.nsh"

    SetOutPath "$INSTDIR"
    WriteUninstaller "$INSTDIR\Uninstall.exe"

    ; Add/Remove Programs. SHCTX is HKLM or HKCU depending on the scope chosen
    ; on the install-mode page; MultiUser.nsh set it.
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "DisplayName"     "${XPCOG_NAME}"
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "DisplayVersion"  "${XPCOG_VERSION}"
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "DisplayIcon"     "$INSTDIR\${XPCOG_EXE},0"
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "Publisher"       "${XPCOG_PUBLISHER}"
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "URLInfoAbout"    "${XPCOG_URL}"
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "InstallLocation" "$INSTDIR"
    ; The scope is passed back explicitly. Without it the uninstaller has to
    ; guess which hive it was registered in, and a per-user install on a machine
    ; that also has a per-machine one guesses wrong.
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "UninstallString" \
        '"$INSTDIR\Uninstall.exe" /$MultiUser.InstallMode'
    WriteRegStr   SHCTX "${XPCOG_UNINST_KEY}" "QuietUninstallString" \
        '"$INSTDIR\Uninstall.exe" /S /$MultiUser.InstallMode'
    WriteRegDWORD SHCTX "${XPCOG_UNINST_KEY}" "NoModify" 1
    WriteRegDWORD SHCTX "${XPCOG_UNINST_KEY}" "NoRepair" 1
    ; Harvest.cmake measured this; an absent EstimatedSize shows as a blank
    ; column rather than as an estimate.
    WriteRegDWORD SHCTX "${XPCOG_UNINST_KEY}" "EstimatedSize" ${XPCOG_PAYLOAD_KIB}
SectionEnd

Section "Start menu shortcut" SecStartMenu
    ; SetOutPath first: it is what the shortcut's working directory is taken
    ; from, and XPCog finds its SoundFonts and equaliser presets relative to the
    ; executable rather than to the working directory -- so this is belt and
    ; braces rather than load-bearing, and cheap enough to keep that way.
    SetOutPath "$INSTDIR"
    CreateShortcut "$SMPROGRAMS\${XPCOG_NAME}.lnk" "$INSTDIR\${XPCOG_EXE}"

    ; Deliberately *not* carrying System.AppUserModel.ID. docs/PORTING.md works
    ; through why the SMTC card says "Unknown app": that needs package identity,
    ; and an AUMID on the shortcut is only half of a contract whose other half --
    ; SetCurrentProcessExplicitAppUserModelID, on every window the app owns --
    ; lives in the application. Setting one half here can leave taskbar pinning
    ; worse than the ID Windows derives on its own. When the app takes its half,
    ; this is where the other half goes.
SectionEnd

Section /o "Desktop shortcut" SecDesktop
    SetOutPath "$INSTDIR"
    CreateShortcut "$DESKTOP\${XPCOG_NAME}.lnk" "$INSTDIR\${XPCOG_EXE}"
SectionEnd

; ---------------------------------------------------------------------------
; File associations.
;
; The same keys the wx player's --register writes (platform/src/windows/
; FileAssociations.cpp), written by this script instead, and the two halves of
; a change of approach worth stating:
;
;   * Under SHCTX, not always HKCU. A per-machine install offers XPCog to every
;     account on the machine; a per-user one to the user who ran it. --register
;     wrote HKCU whatever the scope, so only the account that ran the installer
;     was ever offered it.
;   * The extension list is generated at packaging time from this build's codec
;     registry (Associations.cmake), one XPCogAssociate line per extension, and
;     the uninstaller is built from the same list -- so it removes what was
;     written, without the executable having to be there to say what that was.
;
; Not written: an extension's own default value, which is its current handler.
; Adding to OpenWithProgids offers XPCog; overwriting the default would take the
; file type from whatever has it, and would not work anyway -- since Windows 8
; the effective default is a hash-protected UserChoice only Settings can write.
; ---------------------------------------------------------------------------
!macro XPCogAssociate EXT
    WriteRegStr SHCTX "${XPCOG_CLASSES}\Applications\${XPCOG_EXE}\SupportedTypes" ".${EXT}" ""
    WriteRegStr SHCTX "${XPCOG_CLASSES}\.${EXT}\OpenWithProgids" "${XPCOG_PROGID}" ""
!macroend

; Values only, never keys. An extension's key and its OpenWithProgids are shared
; with every other program that handles the type -- and DeleteRegKey /ifempty
; counts subkeys, not values, so it would take a key holding another program's
; entries with it. An empty key left behind costs nothing.
!macro XPCogDissociate EXT
    DeleteRegValue SHCTX "${XPCOG_CLASSES}\.${EXT}\OpenWithProgids" "${XPCOG_PROGID}"
!macroend

; SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST | SHCNF_FLUSH): without it
; Explorer shows the old "Open with" list until it restarts, which reads as the
; registration having failed.
!macro XPCogNotifyShell
    System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0x1000, p 0, p 0)'
!macroend

Section "Offer XPCog in the $\"Open with$\" lists" SecAssoc
    DetailPrint "Registering file types..."
    WriteRegStr SHCTX "${XPCOG_CLASSES}\${XPCOG_PROGID}" "" "Audio File"
    WriteRegStr SHCTX "${XPCOG_CLASSES}\${XPCOG_PROGID}\DefaultIcon" "" "$INSTDIR\${XPCOG_EXE},0"
    WriteRegStr SHCTX "${XPCOG_CLASSES}\${XPCOG_PROGID}\shell\open\command" "" \
        '"$INSTDIR\${XPCOG_EXE}" "%1"'
    ; FriendlyAppName is what "Open with" shows instead of the image name.
    WriteRegStr SHCTX "${XPCOG_CLASSES}\Applications\${XPCOG_EXE}" "FriendlyAppName" "${XPCOG_NAME}"
    WriteRegStr SHCTX "${XPCOG_CLASSES}\Applications\${XPCOG_EXE}\shell\open\command" "" \
        '"$INSTDIR\${XPCOG_EXE}" "%1"'
    !include "@XPCOG_GENERATED_DIR_NATIVE@\associations-install.nsh"
    !insertmacro XPCogNotifyShell
SectionEnd

!if ${XPCOG_WINUI} == 1
; ---------------------------------------------------------------------------
; The Windows App Runtime.
;
; The WinUI player is unpackaged and framework-dependent: it finds the runtime's
; framework package at start-up through the bootstrapper beside it, and without
; one says so and stops. Microsoft's runtime installer is 120 MB, which would
; triple this installer for the machines that already have it -- so it is
; fetched only where the check below finds no runtime at the version the
; player was built against, from the URL and with the hash
; cmake/XPCogWinAppSdk.cmake pins. A machine offline at install time gets the
; player and a message; running the runtime installer later is enough.
; ---------------------------------------------------------------------------
Section "Windows App Runtime (downloaded if missing)" SecRuntime
    InitPluginsDir
    File "/oname=$PLUGINSDIR\WindowsAppRuntime.ps1" "@XPCOG_RUNTIME_SCRIPT@"
    StrCpy $R1 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\WindowsAppRuntime.ps1"'

    nsExec::Exec '$R1 -Check -Minimum @XPCOG_RUNTIME_MINIMUM@'
    Pop $0
    ${If} $0 == 0
        DetailPrint "The Windows App Runtime @XPCOG_RUNTIME_MINIMUM@ or later is installed."
        Goto xpcog_runtime_done
    ${EndIf}

    DetailPrint "Downloading the Windows App Runtime..."
    nsExec::Exec '$R1 -Download -Url "@XPCOG_WINAPPSDK_RUNTIME_INSTALLER_URL@" -Sha256 @XPCOG_WINAPPSDK_RUNTIME_INSTALLER_SHA256@ -OutFile "$PLUGINSDIR\WindowsAppRuntimeInstall.exe"'
    Pop $0
    ${If} $0 != 0
        DetailPrint "  The download failed ($0)."
        Goto xpcog_runtime_failed
    ${EndIf}

    DetailPrint "Installing the Windows App Runtime..."
    ExecWait '"$PLUGINSDIR\WindowsAppRuntimeInstall.exe" --quiet' $0
    ${If} $0 != 0
        DetailPrint "  The runtime installer exited with $0."
        Goto xpcog_runtime_failed
    ${EndIf}
    Goto xpcog_runtime_done

    xpcog_runtime_failed:
    ; Not fatal: the player is installed, and the runtime can be added after.
    ${IfNot} ${Silent}
        MessageBox MB_OK|MB_ICONEXCLAMATION \
            "The Windows App Runtime could not be installed, and ${XPCOG_NAME} needs it to \
             start.$\n$\nInstall it from @XPCOG_WINAPPSDK_RUNTIME_INSTALLER_URL@ \
             and then run ${XPCOG_NAME}."
    ${EndIf}

    xpcog_runtime_done:
SectionEnd
!endif

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
    !insertmacro MUI_DESCRIPTION_TEXT ${SecCore} \
        "${XPCOG_NAME} and everything it needs to run. Required."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecStartMenu} \
        "A ${XPCOG_NAME} entry in the Start menu."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} \
        "A ${XPCOG_NAME} shortcut on the desktop."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecAssoc} \
        "Add ${XPCOG_NAME} to the $\"Open with$\" list for the audio formats this \
         build understands. It does not take any file type away from the program \
         that currently opens it."
!if ${XPCOG_WINUI} == 1
    !insertmacro MUI_DESCRIPTION_TEXT ${SecRuntime} \
        "The Microsoft runtime ${XPCOG_NAME} is built on, downloaded from Microsoft \
         (about 120 MB) only if this computer does not have it yet."
!endif
!insertmacro MUI_FUNCTION_DESCRIPTION_END

; ---------------------------------------------------------------------------
; Uninstall.
; ---------------------------------------------------------------------------
Section "Uninstall"
    !insertmacro XPCogAbortIfRunning uninstall

    ; Unconditional, and harmless where the component was not chosen: every
    ; step removes one value or key this installer may have written, and
    ; removing one that is absent does nothing. The list is the one the
    ; installer wrote, generated with it.
    DetailPrint "Removing file type registrations..."
    !include "@XPCOG_GENERATED_DIR_NATIVE@\associations-uninstall.nsh"
    DeleteRegKey SHCTX "${XPCOG_CLASSES}\${XPCOG_PROGID}"
    DeleteRegKey SHCTX "${XPCOG_CLASSES}\Applications\${XPCOG_EXE}"
    !insertmacro XPCogNotifyShell

    ; The Windows App Runtime stays: it is Microsoft's, shared by every app on
    ; the machine built on it, and not this program's to remove.

    ; Every Delete line, generated alongside the File lines it undoes.
    !include "@XPCOG_GENERATED_DIR_NATIVE@\payload-uninstall.nsh"

    Delete "$SMPROGRAMS\${XPCOG_NAME}.lnk"
    Delete "$DESKTOP\${XPCOG_NAME}.lnk"

    Delete "$INSTDIR\Uninstall.exe"
    ; Not RMDir /r. This removes the installation directory only if it is empty,
    ; so a crash dump, a log, or anything else the user put beside the program
    ; stops the delete instead of going with it.
    RMDir "$INSTDIR"

    DeleteRegKey SHCTX "${XPCOG_UNINST_KEY}"

    ; Left alone, deliberately: HKCU\Software\LoSnoCo\XPCog (the settings wxConfig
    ; writes) and the library database under %APPDATA%. Those are the user's
    ; data, not the program, and an uninstall that takes a curated library with
    ; it is not recoverable from.
SectionEnd

; ---------------------------------------------------------------------------
; Entry points.
; ---------------------------------------------------------------------------
Function .onInit
    ; The 64-bit registry, whichever installer this was built as.
    ;
    ; A 32-bit installer writing HKLM\Software gets WOW6432Node under it, while
    ; XPCog.exe -- 64-bit, always -- reads the 64-bit view. Everything this
    ; script keeps in the registry is read back by something on the other side of
    ; that: Add/Remove Programs finds the entry either way, but a second run of
    ; this installer looks up InstallLocation to discover where the first one put
    ; things, and the file associations are read by the 64-bit shell.
    ; Without this line an upgrade built with a different NSIS would fail to see
    ; the earlier install and put a second copy beside it.
    ;
    ; Before MULTIUSER_INIT, because that is what reads the key.
    SetRegView 64

    ; x64 only, and said plainly here rather than discovered as "the application
    ; was unable to start correctly (0xc000007b)" after a successful install.
    ; The triplet is x64-windows; there is no 32-bit build to fall back to.
    ${IfNot} ${RunningX64}
        MessageBox MB_OK|MB_ICONSTOP \
            "${XPCOG_NAME} requires 64-bit Windows."
        Abort
    ${EndIf}

    ; /D= survives MULTIUSER_INIT only because of these four lines.
    ;
    ; NSIS's loader applies /D= to $INSTDIR before .onInit runs, and
    ; MULTIUSER_INIT then assigns $INSTDIR the default for the chosen scope --
    ; and again from the registry, if a previous install recorded one --
    ; overwriting it. The failure is quiet in exactly the way that matters:
    ; the install succeeds, reports success, and puts the files somewhere the
    ; caller did not ask for, so an unattended deployment to a chosen directory
    ; silently lands in %LOCALAPPDATA% instead. Measured, not theorised: the
    ; first silent test of this script installed to the default and exited 0.
    ;
    ; This script has no InstallDir directive, so $INSTDIR is empty on entry
    ; unless /D= filled it -- which makes "non-empty" an exact test for "the
    ; caller asked for a directory", and puts it back after MultiUser has had
    ; its say.
    StrCpy $R9 $INSTDIR

    !insertmacro MULTIUSER_INIT

    ${If} $R9 != ""
        StrCpy $INSTDIR $R9
    ${EndIf}

    ; /NOASSOC, for silent installs.
    ;
    ; A component page is a question, and /S is the mode with nobody there to
    ; answer it -- so an unattended install would otherwise rearrange the "Open
    ; with" lists on every machine it is pushed to, silently, because a default
    ; chosen for someone clicking through a wizard was applied to someone who
    ; never saw it. The interactive tick stays on; this is how a deployment says
    ; no. Ignored outside /S only in the sense that the checkbox can also say it.
    ${GetParameters} $R0
    ClearErrors
    ${GetOptions} $R0 "/NOASSOC" $R1
    ${IfNot} ${Errors}
        !insertmacro UnselectSection ${SecAssoc}
    ${EndIf}

!if ${XPCOG_WINUI} == 1
    ; /NORUNTIME, for a deployment that puts the Windows App Runtime on its
    ; machines by its own means and does not want each install reaching out to
    ; Microsoft for it.
    ClearErrors
    ${GetOptions} $R0 "/NORUNTIME" $R1
    ${IfNot} ${Errors}
        !insertmacro UnselectSection ${SecRuntime}
    ${EndIf}
!endif
FunctionEnd

Function un.onInit
    ; The view the installer wrote in. See .onInit; DeleteRegKey in SecUninstall
    ; would otherwise remove a key nobody wrote and leave the real one behind, as
    ; an Add/Remove Programs entry for a program that is no longer there.
    SetRegView 64

    ; The same clobber, and here the correct value is never in doubt: an
    ; uninstaller's $INSTDIR is the directory it is running from, or the one
    ; passed as _?= by the upgrade path in SecCore. MULTIUSER_UNINIT replaces it
    ; with whatever InstallLocation the registry holds, which is the same path
    ; right up until it is not -- a half-removed install, or a registry entry
    ; left by a different copy -- and then this deletes a directory chosen by
    ; a stale registry value rather than the one it was pointed at.
    StrCpy $R9 $INSTDIR

    !insertmacro MULTIUSER_UNINIT

    StrCpy $INSTDIR $R9
FunctionEnd

Function XPCogLaunch
    ; See MUI_FINISHPAGE_RUN above for why this goes through Explorer.
    Exec '"$WINDIR\explorer.exe" "$INSTDIR\${XPCOG_EXE}"'
FunctionEnd
