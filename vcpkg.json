{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "xpcog",
  "version": "0.1.0",
  "description": "Cross-platform Qt port of the Cog audio player",
  "homepage": "https://github.com/losnoco/Cog",
  "license": "GPL-2.0-or-later",
  "builtin-baseline": "17f35ad2418007a895ced8a4cece4ab34068a58d",
  "dependencies": [
    "sqlite3",
    "soxr",
    "libogg",
    "libflac",
    "libvorbis",
    "opus",
    "opusfile",
    "mpg123",
    "wavpack",
    "taglib",
    "libopenmpt",
    "libgme",
    "libarchive",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    {
      "name": "catch2",
      "host": false
    }
  ],
  "features": {
    "ffmpeg": {
      "description": "FFmpeg decoder: AAC, ALAC, WMA, AC3, DTS, TAK, and more (long build)",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample"
          ]
        }
      ]
    }
  }
}
