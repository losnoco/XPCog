+        # The same CMake config as the MSVC branch above, rather than
+        # pkg-config. Vorbis ships VorbisConfig.cmake on every platform, while
+        # pkg-config is a tool that may simply not be installed -- and the
+        # branch this replaces called pkg_check_modules with REQUIRED, so a
+        # macOS or Linux build without it failed at configure time instead of
+        # quietly losing Vorbis-compressed SF3 banks.
+        find_package(Vorbis CONFIG REQUIRED)
+        target_sources(spessasynth PRIVATE src/soundbank/vorbis_decode.c)
+        target_link_libraries(spessasynth PRIVATE Vorbis::vorbisfile)
+        target_compile_definitions(spessasynth PRIVATE SS_HAVE_LIBVORBISFILE=1)
+        message(STATUS "libvorbisfile found")
