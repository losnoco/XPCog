/* config.h for libsidplayfp, generated by the port's CMakeLists rather than by
 * autoconf. Upstream ships autotools only; see ../portfile.cmake for why this
 * build does not use it.
 *
 * Only the entries libsidplayfp's sources actually reach for are here, rather
 * than the whole of what `./configure` emits. Note that PACKAGE_URL is one of
 * them -- SidInfoImpl.h pastes it into the credits string -- which is why the
 * PACKAGE_* block below is longer than a feature-probe header suggests. */
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_STDIO_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_UNISTD_H 1

#cmakedefine HAVE_STRCASECMP 1
#cmakedefine HAVE_STRNCASECMP 1
/* MSVC's spellings of the same two. SidTuneTools tests all four. */
#cmakedefine HAVE_STRICMP 1
#cmakedefine HAVE_STRNICMP 1

#cmakedefine HAVE_LOG1P 1

/* Selects the Win32 paths in SidDatabase and the STIL reader. */
#cmakedefine HAVE_MSWINDOWS 1

/* SIMD headers the reSIDfp resampler probes for. */
#cmakedefine HAVE_MMINTRIN_H 1
#cmakedefine HAVE_EMMINTRIN_H 1
#cmakedefine HAVE_ARM_NEON_H 1

#define PACKAGE "@PACKAGE@"
#define PACKAGE_NAME "@PACKAGE_NAME@"
#define PACKAGE_TARNAME "@PACKAGE@"
#define PACKAGE_VERSION "@PACKAGE_VERSION@"
#define PACKAGE_STRING "@PACKAGE_NAME@ @PACKAGE_VERSION@"
#define PACKAGE_URL "@PACKAGE_URL@"
#define PACKAGE_BUGREPORT ""
#define VERSION "@PACKAGE_VERSION@"

#define HAVE_CXX11 1
#define HAVE_CXX14 1

/* The C++ compilers this builds under have had `bool` for thirty years; the
 * probe exists for pre-standard compilers and there is no configuration here
 * where it should be absent. */
#define HAVE_BOOL 1

/* Built without libgcrypt, so the bundled MD5 is used. Cog's own
 * update-generated.sh passes --without-gcrypt for the same reason: it is one
 * hash of a tune's memory image, not a security boundary. */
/* #undef HAVE_LIBGCRYPT */
